# Example environment variables for running AnnaSuraksha v5.1
# Copy this file to .env or export the variables in your environment.

# JWT secret used to sign tokens. REQUIRED outside the dev/demo profile: the app refuses to start
# if unset, shorter than 32 chars, or equal to the old built-in demo key. Generate a unique random value.
JWT_SECRET=

# Groq / LLM API key (optional for demo — service falls back to deterministic explanation)
GROQ_API_KEY=YOUR_GROQ_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# Demo mode — seed 50 beneficiaries, 150 FPS deliveries, fraud cases, users
ANNASURAKSHA_SEED_DEMO=false

# Demo user passwords (auto-generated as 16-char Base64 if not set)
# DEMO_ADMIN_PW=admin123
# DEMO_OFFICER_PW=officer123
# DEMO_AUDIT_PW=audit123
# DEMO_FPS_PW=fps123

# Dev bootstrap secret (for minting dev tokens in local dev)
# DEV_BOOTSTRAP_SECRET=verysecret

# Production DB example (replace for your environment)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/annasuraksha
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=secret

# Optional: override server port
# SERVER_PORT=8081
